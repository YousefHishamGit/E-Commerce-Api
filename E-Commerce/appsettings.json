{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Shop": {
    "FlatShippingCost": 50,
    "FreeShippingThreshold": 1000,
    "TaxRatePercent": 14
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "EmailConfirmationHours": 24,
    "PasswordResetMinutes": 60,
    "FrontendUrl": "http://localhost:3000"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromEmail": "no-reply@yourshop.com",
    "FromName": "E-Commerce",
    "LogBodies": false
  },
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com",
    "SecretKey": "",
    "PublicKey": "",
    "HmacSecret": "",
    "CardIntegrationId": 0,
    "WalletIntegrationId": 0,
    "NotificationUrl": "",
    "Currency": "EGP",
    "UnpaidOrderMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200", "http://localhost:5173" ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "JWT": {
    "Secret": "",
    "Issuer": "ECommerceAPI",
    "Audience": "ECommerceClient",
    "ExpiryMinutes": 15
  }
}
